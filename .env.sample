# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

# Django
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgresql-password
DB_HOST=localhost
DB_PORT=5432
# Required by the LangGraph PostgreSQL checkpointer.
DATABASE_URL=postgresql://postgres:replace-with-your-postgresql-password@localhost:5432/ecommerce

# AI providers
GOOGLE_API_KEY=your_google_gemini_api_key
GROQ_SQL_API_KEY=your_groq_api_key_for_analytics

# Stripe Checkout
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

# Email
# Leave EMAIL_BACKEND as the console backend for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=store@example.com

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce-agent

# Production-only settings
# Set DEBUG=False and replace the hosts/origins with your HTTPS domain.
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
