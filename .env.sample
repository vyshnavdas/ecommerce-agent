# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

# Django and PostgreSQL
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce

# AI providers
GOOGLE_API_KEY=your_google_gemini_api_key
GROQ_SQL_API_KEY=your_groq_api_key_for_analytics

# Stripe Checkout
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

# Email
# Leave EMAIL_BACKEND as the console backend for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=store@example.com

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce-agent
